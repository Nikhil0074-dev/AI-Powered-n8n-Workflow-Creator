{
  "name": "Webhook to Slack",
  "description": "Sends Slack notification when webhook is triggered",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-notify",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "channel": "#general",
        "text": "🔔 *New Webhook Received*\n\n{{ $json.body }}",
        "options": {
          "username": "n8n Bot",
          "icon_emoji": "🤖"
        }
      },
      "id": "slack-node",
      "name": "Send Slack Message",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1.2,
      "position": [450, 300],
      "credentials": {
        "slackApi": "slack-api"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Send Slack Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
