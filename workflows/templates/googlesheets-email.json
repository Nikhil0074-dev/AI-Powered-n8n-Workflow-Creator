{
  "name": "Google Sheets to Email",
  "description": "Sends email when new row is added to Google Sheets",
  "nodes": [
    {
      "parameters": {
        "operation": "rowWatch",
        "sheetId": "{{ $credentials.googleSheets }}",
        "options": {}
      },
      "id": "google-sheets-trigger",
      "name": "Google Sheets - Row Created",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 3.2,
      "position": [250, 300],
      "credentials": {
        "googleSheetsOAuth2": "google-sheets"
      }
    },
    {
      "parameters": {
        "toEmail": "{{ $json.email }}",
        "subject": "New Record Added: {{ $json.name }}",
        "body": "A new record has been added to Google Sheets.\n\nDetails:\n{{ $json }}",
        "options": {}
      },
      "id": "email-node",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1.2,
      "position": [450, 300],
      "credentials": {
        "smtp": "smtp-credentials"
      }
    }
  ],
  "connections": {
    "Google Sheets - Row Created": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
